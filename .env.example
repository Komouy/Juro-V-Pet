# JURO Virtual Pet Environment Variables

# App Config
VITE_APP_NAME="JURO Virtual Pet"
VITE_APP_VERSION="1.0.0"

# Google Gemini API Key (Untuk fitur AI Chat Juro langsung bagi semua pengunjung website)
# Dapatkan gratis di https://aistudio.google.com/app/apikey
# Buat file .env.local dan isi baris di bawah:
VITE_GEMINI_API_KEY=AIzaSy_GANTI_DENGAN_API_KEY_ANDA

# Supabase (Masa Depan)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
